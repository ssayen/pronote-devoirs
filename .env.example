# Copier en .env (jamais commité) et adapter.
# Code d'invitation à donner aux proches pour qu'ils créent leur compte (page /register).
# Vide : seul le premier compte peut s'inscrire, ensuite les inscriptions sont fermées.
INVITE_CODE=choisir-un-code-long
# Ancienne installation uniquement (l'enfant se règle maintenant par compte)
CHILD_NAME=
SYNC_INTERVAL_MIN=30
PUSH_TO_PRONOTE=0
# Notification (compatible ntfy) quand Pronote refuse le jeton ; laisser vide pour désactiver.
# Le topic fait office de mot de passe : en choisir un long et impossible à deviner.
NOTIFY_URL=
NOTIFY_TOKEN=
